---
import { TEAMS, TEAM_INFO, TIER_CONFIG } from '../lib/teams.js'

const tiers = ['favorito', 'creyente', 'maleta'] as const

const tierDescriptions: Record<string, string> = {
  favorito: 'Los candidatos serios. Tienen el plantel, el historial y la presión para ganar el torneo.',
  creyente: 'Capaces de llegar lejos si los astros se alinean. Peligrosos en el momento correcto.',
  maleta:   'El fútbol es redondo. Clasificaron con mérito y cualquier victoria es un regalo para tu quiniela.',
}

const tierColors: Record<string, string> = {
  favorito: 'text-wc-gold',
  creyente: 'text-blue-400',
  maleta:   'text-wc-muted',
}
---

<section>
  <h2 class="font-display text-3xl text-wc-gold mb-6 tracking-wide">EQUIPOS</h2>

  {tiers.map(tier => {
    const cfg  = TIER_CONFIG[tier]
    const teams = TEAMS.filter(t => t.tier === tier)
    const color = tierColors[tier]
    return (
      <div class="mb-8">
        <div class="flex items-center gap-2 mb-1">
          <i class:list={['ph', cfg.icon, color, 'text-base']}></i>
          <h3 class:list={['font-display text-xl tracking-wide', color]}>{cfg.label.toUpperCase()}</h3>
          <span class:list={['text-xs ml-1', color, 'opacity-60']}>({teams.length})</span>
        </div>
        <p class="text-xs text-wc-muted mb-3">{tierDescriptions[tier]}</p>
        <div class="flex flex-wrap gap-2">
          {teams.map(team => {
            const info = TEAM_INFO[team.code]
            return (
              <button
                class="team-badge text-sm team-info-btn"
                data-code={team.code}
                data-name={team.name}
                data-flag={team.flag}
                data-rank={info?.fifaRank ?? '?'}
                data-prob={info?.winProb ?? '?'}
                data-summary={info?.summary ?? ''}
                type="button"
              >
                {team.flag} {team.name}
              </button>
            )
          })}
        </div>
      </div>
    )
  })}
</section>

<!-- Shared tooltip -->
<div
  id="teams-tooltip"
  class="hidden fixed z-50 w-[min(20rem,calc(100vw-2rem))] card p-4 border border-wc-blue/40 shadow-2xl"
  style="left:50%;top:50%;transform:translate(-50%,-50%)"
>
  <div class="flex items-center gap-2 mb-3">
    <span id="tt-flag" class="text-3xl leading-none"></span>
    <h4 id="tt-name" class="font-semibold text-white text-base"></h4>
  </div>
  <div class="flex gap-6 mb-3">
    <div>
      <p class="text-[10px] text-wc-muted uppercase tracking-wide mb-0.5">Ranking FIFA</p>
      <p id="tt-rank" class="text-white font-bold text-xl leading-none"></p>
    </div>
    <div>
      <p class="text-[10px] text-wc-muted uppercase tracking-wide mb-0.5">Prob. campeón</p>
      <p id="tt-prob" class="text-wc-gold font-bold text-xl leading-none"></p>
    </div>
  </div>
  <p id="tt-summary" class="text-xs text-wc-muted leading-relaxed"></p>
  <button id="tt-close" class="mt-3 text-wc-gold text-xs underline underline-offset-2" type="button">Cerrar</button>
</div>

<script is:inline>
(function () {
  const tooltip = document.getElementById('teams-tooltip')
  if (!tooltip) return
  const ttFlag    = document.getElementById('tt-flag')
  const ttName    = document.getElementById('tt-name')
  const ttRank    = document.getElementById('tt-rank')
  const ttProb    = document.getElementById('tt-prob')
  const ttSummary = document.getElementById('tt-summary')
  const ttClose   = document.getElementById('tt-close')

  let locked = null

  function show(btn) {
    ttFlag.textContent    = btn.dataset.flag
    ttName.textContent    = btn.dataset.name
    ttRank.textContent    = '#' + btn.dataset.rank
    ttProb.textContent    = btn.dataset.prob
    ttSummary.textContent = btn.dataset.summary
    tooltip.classList.remove('hidden')
  }

  function hide() {
    locked = null
    tooltip.classList.add('hidden')
  }

  document.querySelectorAll('.team-info-btn').forEach(function (btn) {
    btn.addEventListener('mouseenter', function () {
      if (!locked) show(btn)
    })
    btn.addEventListener('mouseleave', function () {
      if (!locked) tooltip.classList.add('hidden')
    })
    btn.addEventListener('click', function (e) {
      e.stopPropagation()
      if (locked === btn) {
        hide()
      } else {
        locked = btn
        show(btn)
      }
    })
  })

  tooltip.addEventListener('click', function (e) { e.stopPropagation() })
  if (ttClose) ttClose.addEventListener('click', hide)
  document.addEventListener('click', hide)
})()
</script>
