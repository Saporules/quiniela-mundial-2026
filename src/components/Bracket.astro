---
import { getTeam } from '../lib/teams.js'
import type { KnockoutRounds, KnockoutMatch } from '../lib/espn.js'

interface Props {
  assignments: Array<{ team_code: string; participant_name: string; share_percentage: number }>
  knockout?: KnockoutRounds
}
const { assignments, knockout } = Astro.props

const ko: KnockoutRounds = knockout ?? { r32: [], r16: [], qf: [], sf: [], third: [], final: [] }

// Participant(s) who own a given team code (empty for placeholders / unowned teams).
function owners(code: string | undefined): string[] {
  if (!code) return []
  const up = code.toUpperCase()
  return assignments.filter(a => a.team_code === code || a.team_code === up).map(a => a.participant_name)
}

// Turn an ESPN code into a display label: real team → "🇧🇷 Brasil";
// group placeholder → "2°F" / "3ro"; later-round placeholder (RD32, QFW1…) → null (TBD).
function label(code: string | undefined): string | null {
  if (!code) return null
  const team = getTeam(code)
  if (team) return `${team.flag} ${team.name}`
  const grp = code.match(/^([123])([A-L])$/)
  if (grp) return `${grp[1]}°${grp[2]}`
  if (code === '3RD') return '3ro'
  return null
}

interface DMatch {
  home: string | null; away: string | null
  homeOwners: string[]; awayOwners: string[]
  homeScore: number | null; awayScore: number | null
  homeShootout: number | null; awayShootout: number | null
  live: boolean
  date: string | null    // ISO kickoff; formatted to the viewer's local time on the client
}

// Map a round's ESPN matches into fixed-length display slots (pads with empty TBD slots).
function build(list: KnockoutMatch[], count: number): DMatch[] {
  return Array.from({ length: count }, (_, i) => {
    const m = list[i]
    return m
      ? { home: label(m.home), away: label(m.away), homeOwners: owners(m.home), awayOwners: owners(m.away), homeScore: m.homeScore, awayScore: m.awayScore, homeShootout: m.homeShootout, awayShootout: m.awayShootout, live: m.state === 'in', date: m.date }
      : { home: null, away: null, homeOwners: [], awayOwners: [], homeScore: null, awayScore: null, homeShootout: null, awayShootout: null, live: false, date: null }
  })
}

const rounds = [
  { name: 'Ronda 32',   short: 'R32', matches: build(ko.r32, 16) },
  { name: 'Octavos',    short: 'R16', matches: build(ko.r16, 8) },
  { name: 'Cuartos',    short: 'QF',  matches: build(ko.qf, 4) },
  { name: 'Semis',      short: 'SF',  matches: build(ko.sf, 2) },
  { name: 'Final',      short: 'F',   matches: build(ko.final, 1) },
  { name: '3er Puesto', short: '3°',  matches: build(ko.third, 1) },
]

const hasData = [ko.r32, ko.r16, ko.qf, ko.sf, ko.final].some(r => r.length > 0)
---

<section>
  <h2 class="font-display text-3xl text-wc-gold mb-2 tracking-wide">LLAVES</h2>
  <p class="text-sm text-wc-muted mb-4">
    {hasData ? 'Cuadro de eliminación directa · se actualiza en vivo' : 'La fase eliminatoria comienza cuando terminan los grupos'}
  </p>

  <!-- Toggle button -->
  <div class="flex items-center gap-3 mb-6">
    <button
      id="bracket-toggle"
      onclick="toggleBracketView()"
      class="flex items-center gap-2 text-xs px-3 py-1.5 rounded-lg border border-wc-border text-wc-muted hover:text-white hover:border-wc-gold/40 transition-colors"
    >
      <i class="ph ph-list" id="bracket-toggle-icon"></i>
      <span id="bracket-toggle-label">Ver en lista</span>
    </button>
  </div>

  <!-- BRACKET VISUAL (default) -->
  <div id="bracket-visual" class="overflow-x-auto pb-4 cursor-grab select-none" style="scroll-behavior:smooth">
    <div style="width:max-content;margin:0 auto;padding:1.5rem 3rem">
    <div class="relative flex items-center gap-4 py-8">

      <!-- LEFT: R32(0-7) → R16(0-3) → QF(0-1) → SF(0) -->
      <div class="flex gap-4 items-center">
        <!-- R32 left -->
        <div class="flex flex-col gap-2" style="width:160px">
          <p class="font-display text-wc-muted text-xs text-center mb-1">RONDA 32</p>
          {rounds[0]!.matches.slice(0, 8).map((m) => (
            <div class="bracket-match card p-2 text-xs">
              <div class="flex justify-between items-center py-0.5 hover:text-white transition-colors">
                <span class="min-w-0 flex flex-col">
                  <span class="text-wc-muted truncate">{m.home ?? 'TBD'}</span>
                  {m.homeOwners.length > 0 && <span class="text-blue-300 text-[9px] truncate leading-tight">{m.homeOwners.join(', ')}</span>}
                </span>
                <span class="font-bold ml-2 text-wc-gold">{m.homeScore ?? '-'}{m.homeShootout != null && <span class="text-[9px] text-wc-muted font-normal ml-0.5">({m.homeShootout})</span>}</span>
              </div>
              <div class="flex justify-between items-center py-0.5 hover:text-white transition-colors">
                <span class="min-w-0 flex flex-col">
                  <span class="text-wc-muted truncate">{m.away ?? 'TBD'}</span>
                  {m.awayOwners.length > 0 && <span class="text-blue-300 text-[9px] truncate leading-tight">{m.awayOwners.join(', ')}</span>}
                </span>
                <span class="font-bold ml-2 text-wc-gold">{m.awayScore ?? '-'}{m.awayShootout != null && <span class="text-[9px] text-wc-muted font-normal ml-0.5">({m.awayShootout})</span>}</span>
              </div>
            </div>
          ))}
        </div>

        <!-- R16 left -->
        <div class="flex flex-col gap-8 justify-around" style="width:160px">
          <p class="font-display text-wc-muted text-xs text-center mb-1">OCTAVOS</p>
          {rounds[1]!.matches.slice(0, 4).map((m) => (
            <div class="bracket-match card p-2 text-xs">
              <div class="flex justify-between items-center py-0.5">
                <span class="min-w-0 flex flex-col">
                  <span class="text-wc-muted truncate">{m.home ?? 'TBD'}</span>
                  {m.homeOwners.length > 0 && <span class="text-blue-300 text-[9px] truncate leading-tight">{m.homeOwners.join(', ')}</span>}
                </span>
                <span class="font-bold ml-2 text-wc-gold">{m.homeScore ?? '-'}{m.homeShootout != null && <span class="text-[9px] text-wc-muted font-normal ml-0.5">({m.homeShootout})</span>}</span>
              </div>
              <div class="flex justify-between items-center py-0.5">
                <span class="min-w-0 flex flex-col">
                  <span class="text-wc-muted truncate">{m.away ?? 'TBD'}</span>
                  {m.awayOwners.length > 0 && <span class="text-blue-300 text-[9px] truncate leading-tight">{m.awayOwners.join(', ')}</span>}
                </span>
                <span class="font-bold ml-2 text-wc-gold">{m.awayScore ?? '-'}{m.awayShootout != null && <span class="text-[9px] text-wc-muted font-normal ml-0.5">({m.awayShootout})</span>}</span>
              </div>
            </div>
          ))}
        </div>

        <!-- QF left -->
        <div class="flex flex-col gap-24 justify-around" style="width:140px">
          <p class="font-display text-wc-muted text-xs text-center mb-1">CUARTOS</p>
          {rounds[2]!.matches.slice(0, 2).map((m) => (
            <div class="bracket-match card p-2 text-xs">
              <div class="flex justify-between items-center py-0.5">
                <span class="min-w-0 flex flex-col">
                  <span class="text-wc-muted truncate">{m.home ?? 'TBD'}</span>
                  {m.homeOwners.length > 0 && <span class="text-blue-300 text-[9px] truncate leading-tight">{m.homeOwners.join(', ')}</span>}
                </span>
                <span class="font-bold ml-2 text-wc-gold">{m.homeScore ?? '-'}{m.homeShootout != null && <span class="text-[9px] text-wc-muted font-normal ml-0.5">({m.homeShootout})</span>}</span>
              </div>
              <div class="flex justify-between items-center py-0.5">
                <span class="min-w-0 flex flex-col">
                  <span class="text-wc-muted truncate">{m.away ?? 'TBD'}</span>
                  {m.awayOwners.length > 0 && <span class="text-blue-300 text-[9px] truncate leading-tight">{m.awayOwners.join(', ')}</span>}
                </span>
                <span class="font-bold ml-2 text-wc-gold">{m.awayScore ?? '-'}{m.awayShootout != null && <span class="text-[9px] text-wc-muted font-normal ml-0.5">({m.awayShootout})</span>}</span>
              </div>
            </div>
          ))}
        </div>

        <!-- SF left -->
        <div class="flex flex-col justify-center" style="width:140px">
          <p class="font-display text-wc-muted text-xs text-center mb-1">SEMIFINAL</p>
          <div class="bracket-match card p-2 text-xs mt-8">
            <div class="flex justify-between items-center py-0.5">
              <span class="min-w-0 flex flex-col">
                <span class="text-wc-muted truncate">{rounds[3]!.matches[0]!.home ?? 'TBD'}</span>
                {rounds[3]!.matches[0]!.homeOwners.length > 0 && <span class="text-blue-300 text-[9px] truncate leading-tight">{rounds[3]!.matches[0]!.homeOwners.join(', ')}</span>}
              </span>
              <span class="font-bold ml-2 text-wc-gold">{rounds[3]!.matches[0]!.homeScore ?? '-'}{rounds[3]!.matches[0]!.homeShootout != null && <span class="text-[9px] text-wc-muted font-normal ml-0.5">({rounds[3]!.matches[0]!.homeShootout})</span>}</span>
            </div>
            <div class="flex justify-between items-center py-0.5">
              <span class="min-w-0 flex flex-col">
                <span class="text-wc-muted truncate">{rounds[3]!.matches[0]!.away ?? 'TBD'}</span>
                {rounds[3]!.matches[0]!.awayOwners.length > 0 && <span class="text-blue-300 text-[9px] truncate leading-tight">{rounds[3]!.matches[0]!.awayOwners.join(', ')}</span>}
              </span>
              <span class="font-bold ml-2 text-wc-gold">{rounds[3]!.matches[0]!.awayScore ?? '-'}{rounds[3]!.matches[0]!.awayShootout != null && <span class="text-[9px] text-wc-muted font-normal ml-0.5">({rounds[3]!.matches[0]!.awayShootout})</span>}</span>
            </div>
          </div>
        </div>
      </div>

      <!-- CENTER: Copa + Final -->
      <div class="flex flex-col items-center gap-4 px-4" style="min-width:200px">
        <img
          src={`${import.meta.env.BASE_URL}copa-del-mundo.png`}
          alt="Copa del Mundo"
          class="drop-shadow-[0_0_40px_rgba(249,168,37,0.5)]"
          style="width:120px;height:auto"
        />
        <div class="text-center">
          <p class="font-display text-wc-gold text-xl tracking-widest mb-2">GRAN FINAL</p>
          <div class="card p-3 border-wc-gold/40 min-w-[180px]">
            <div class="flex justify-between items-center py-1">
              <span class="min-w-0 flex flex-col">
                <span class="text-white font-semibold truncate">{rounds[4]!.matches[0]!.home ?? 'TBD'}</span>
                {rounds[4]!.matches[0]!.homeOwners.length > 0 && <span class="text-blue-300 text-[10px] truncate leading-tight">{rounds[4]!.matches[0]!.homeOwners.join(', ')}</span>}
              </span>
              <span class="font-display text-wc-gold text-xl ml-3">{rounds[4]!.matches[0]!.homeScore ?? '-'}{rounds[4]!.matches[0]!.homeShootout != null && <span class="text-[10px] text-wc-muted ml-0.5">({rounds[4]!.matches[0]!.homeShootout})</span>}</span>
            </div>
            <div class="border-t border-wc-border my-1"></div>
            <div class="flex justify-between items-center py-1">
              <span class="min-w-0 flex flex-col">
                <span class="text-white font-semibold truncate">{rounds[4]!.matches[0]!.away ?? 'TBD'}</span>
                {rounds[4]!.matches[0]!.awayOwners.length > 0 && <span class="text-blue-300 text-[10px] truncate leading-tight">{rounds[4]!.matches[0]!.awayOwners.join(', ')}</span>}
              </span>
              <span class="font-display text-wc-gold text-xl ml-3">{rounds[4]!.matches[0]!.awayScore ?? '-'}{rounds[4]!.matches[0]!.awayShootout != null && <span class="text-[10px] text-wc-muted ml-0.5">({rounds[4]!.matches[0]!.awayShootout})</span>}</span>
            </div>
          </div>
        </div>
      </div>

      <!-- RIGHT: SF(1) → QF(2-3) → R16(4-7) → R32(8-15) — score left, name right -->
      <div class="flex gap-4 items-center">
        <!-- SF right -->
        <div class="flex flex-col justify-center" style="width:140px">
          <p class="font-display text-wc-muted text-xs text-center mb-1">SEMIFINAL</p>
          <div class="bracket-match card p-2 text-xs mt-8">
            <div class="flex justify-between items-center py-0.5">
              <span class="font-bold mr-2 text-wc-gold">{(rounds[3]!.matches[1]?.homeShootout ?? null) != null && <span class="text-[9px] text-wc-muted font-normal mr-0.5">({rounds[3]!.matches[1]!.homeShootout})</span>}{rounds[3]!.matches[1]?.homeScore ?? '-'}</span>
              <span class="min-w-0 flex flex-col items-end">
                <span class="text-wc-muted truncate text-right">{rounds[3]!.matches[1]?.home ?? 'TBD'}</span>
                {(rounds[3]!.matches[1]?.homeOwners.length ?? 0) > 0 && <span class="text-blue-300 text-[9px] truncate leading-tight text-right">{rounds[3]!.matches[1]!.homeOwners.join(', ')}</span>}
              </span>
            </div>
            <div class="flex justify-between items-center py-0.5">
              <span class="font-bold mr-2 text-wc-gold">{(rounds[3]!.matches[1]?.awayShootout ?? null) != null && <span class="text-[9px] text-wc-muted font-normal mr-0.5">({rounds[3]!.matches[1]!.awayShootout})</span>}{rounds[3]!.matches[1]?.awayScore ?? '-'}</span>
              <span class="min-w-0 flex flex-col items-end">
                <span class="text-wc-muted truncate text-right">{rounds[3]!.matches[1]?.away ?? 'TBD'}</span>
                {(rounds[3]!.matches[1]?.awayOwners.length ?? 0) > 0 && <span class="text-blue-300 text-[9px] truncate leading-tight text-right">{rounds[3]!.matches[1]!.awayOwners.join(', ')}</span>}
              </span>
            </div>
          </div>
        </div>

        <!-- QF right -->
        <div class="flex flex-col gap-24 justify-around" style="width:140px">
          <p class="font-display text-wc-muted text-xs text-center mb-1">CUARTOS</p>
          {rounds[2]!.matches.slice(2, 4).map((m) => (
            <div class="bracket-match card p-2 text-xs">
              <div class="flex justify-between items-center py-0.5">
                <span class="font-bold mr-2 text-wc-gold">{m.homeShootout != null && <span class="text-[9px] text-wc-muted font-normal mr-0.5">({m.homeShootout})</span>}{m.homeScore ?? '-'}</span>
                <span class="min-w-0 flex flex-col items-end">
                  <span class="text-wc-muted truncate text-right">{m.home ?? 'TBD'}</span>
                  {m.homeOwners.length > 0 && <span class="text-blue-300 text-[9px] truncate leading-tight text-right">{m.homeOwners.join(', ')}</span>}
                </span>
              </div>
              <div class="flex justify-between items-center py-0.5">
                <span class="font-bold mr-2 text-wc-gold">{m.awayShootout != null && <span class="text-[9px] text-wc-muted font-normal mr-0.5">({m.awayShootout})</span>}{m.awayScore ?? '-'}</span>
                <span class="min-w-0 flex flex-col items-end">
                  <span class="text-wc-muted truncate text-right">{m.away ?? 'TBD'}</span>
                  {m.awayOwners.length > 0 && <span class="text-blue-300 text-[9px] truncate leading-tight text-right">{m.awayOwners.join(', ')}</span>}
                </span>
              </div>
            </div>
          ))}
        </div>

        <!-- R16 right -->
        <div class="flex flex-col gap-8 justify-around" style="width:160px">
          <p class="font-display text-wc-muted text-xs text-center mb-1">OCTAVOS</p>
          {rounds[1]!.matches.slice(4, 8).map((m) => (
            <div class="bracket-match card p-2 text-xs">
              <div class="flex justify-between items-center py-0.5">
                <span class="font-bold mr-2 text-wc-gold">{m.homeShootout != null && <span class="text-[9px] text-wc-muted font-normal mr-0.5">({m.homeShootout})</span>}{m.homeScore ?? '-'}</span>
                <span class="min-w-0 flex flex-col items-end">
                  <span class="text-wc-muted truncate text-right">{m.home ?? 'TBD'}</span>
                  {m.homeOwners.length > 0 && <span class="text-blue-300 text-[9px] truncate leading-tight text-right">{m.homeOwners.join(', ')}</span>}
                </span>
              </div>
              <div class="flex justify-between items-center py-0.5">
                <span class="font-bold mr-2 text-wc-gold">{m.awayShootout != null && <span class="text-[9px] text-wc-muted font-normal mr-0.5">({m.awayShootout})</span>}{m.awayScore ?? '-'}</span>
                <span class="min-w-0 flex flex-col items-end">
                  <span class="text-wc-muted truncate text-right">{m.away ?? 'TBD'}</span>
                  {m.awayOwners.length > 0 && <span class="text-blue-300 text-[9px] truncate leading-tight text-right">{m.awayOwners.join(', ')}</span>}
                </span>
              </div>
            </div>
          ))}
        </div>

        <!-- R32 right -->
        <div class="flex flex-col gap-2" style="width:160px">
          <p class="font-display text-wc-muted text-xs text-center mb-1">RONDA 32</p>
          {rounds[0]!.matches.slice(8, 16).map((m) => (
            <div class="bracket-match card p-2 text-xs">
              <div class="flex justify-between items-center py-0.5">
                <span class="font-bold mr-2 text-wc-gold">{m.homeShootout != null && <span class="text-[9px] text-wc-muted font-normal mr-0.5">({m.homeShootout})</span>}{m.homeScore ?? '-'}</span>
                <span class="min-w-0 flex flex-col items-end">
                  <span class="text-wc-muted truncate text-right">{m.home ?? 'TBD'}</span>
                  {m.homeOwners.length > 0 && <span class="text-blue-300 text-[9px] truncate leading-tight text-right">{m.homeOwners.join(', ')}</span>}
                </span>
              </div>
              <div class="flex justify-between items-center py-0.5">
                <span class="font-bold mr-2 text-wc-gold">{m.awayShootout != null && <span class="text-[9px] text-wc-muted font-normal mr-0.5">({m.awayShootout})</span>}{m.awayScore ?? '-'}</span>
                <span class="min-w-0 flex flex-col items-end">
                  <span class="text-wc-muted truncate text-right">{m.away ?? 'TBD'}</span>
                  {m.awayOwners.length > 0 && <span class="text-blue-300 text-[9px] truncate leading-tight text-right">{m.awayOwners.join(', ')}</span>}
                </span>
              </div>
            </div>
          ))}
        </div>
      </div>

    </div>
    </div><!-- /max-content wrapper -->
  </div>

  <!-- LIST VIEW (hidden by default) -->
  <div id="bracket-list" class="hidden">
    <div class="flex overflow-x-auto gap-2 pb-2 mb-4">
      {rounds.map((r, i) => (
        <button
          class:list={['bracket-tab flex-shrink-0 px-4 py-2 rounded-lg text-sm font-medium transition-colors', i === 4 ? 'bg-wc-gold text-wc-dark' : 'bg-wc-card border border-wc-border text-wc-muted hover:text-white']}
          data-round={i}
          onclick={`showRound(${i})`}
        >
          {r.short}
        </button>
      ))}
    </div>

    {rounds.map((round, roundIdx) => (
      <div class="bracket-round-mobile" id={`round-${roundIdx}`} style={roundIdx !== 4 ? 'display:none' : ''}>
        <h3 class="font-semibold text-wc-gold mb-3">{round.name}</h3>
        <div class="space-y-2">
          {round.matches.map((match) => (
            <div class="card p-3">
              <div class="flex items-center gap-3">
                <div class="flex-1 min-w-0">
                  <div class="text-sm font-medium text-wc-muted">{match.home ?? 'Por definir'}</div>
                  {match.homeOwners.length > 0 && (
                    <div class="flex flex-wrap gap-1 mt-1">
                      {match.homeOwners.map(o => (
                        <span class="text-[10px] px-1.5 py-0 rounded-full bg-blue-900/50 text-blue-300">{o}</span>
                      ))}
                    </div>
                  )}
                </div>
                <div class="px-3 py-1 bg-wc-dark rounded shrink-0 text-center">
                  <div class="font-display text-wc-gold text-lg leading-none">
                    {match.homeScore !== null ? match.homeScore : '-'} : {match.awayScore !== null ? match.awayScore : '-'}
                  </div>
                  {(match.homeShootout != null || match.awayShootout != null) && (
                    <div class="text-[10px] text-wc-muted font-normal mt-0.5 leading-none">pen. {match.homeShootout ?? 0}-{match.awayShootout ?? 0}</div>
                  )}
                </div>
                <div class="flex-1 min-w-0">
                  <div class="text-sm font-medium text-wc-muted text-right">{match.away ?? 'Por definir'}</div>
                  {match.awayOwners.length > 0 && (
                    <div class="flex flex-wrap gap-1 mt-1 justify-end">
                      {match.awayOwners.map(o => (
                        <span class="text-[10px] px-1.5 py-0 rounded-full bg-blue-900/50 text-blue-300">{o}</span>
                      ))}
                    </div>
                  )}
                </div>
              </div>
              {match.date && (
                <p class="text-[11px] text-wc-muted/80 text-center mt-2 flex items-center justify-center gap-1">
                  <i class="ph ph-calendar-blank"></i>
                  <span class="ko-date" data-utc={match.date}>—</span>
                </p>
              )}
            </div>
          ))}
        </div>
      </div>
    ))}
  </div>
</section>

<script is:inline>
var _bracketShowingVisual = true

function toggleBracketView() {
  _bracketShowingVisual = !_bracketShowingVisual
  document.getElementById('bracket-visual').classList.toggle('hidden', !_bracketShowingVisual)
  document.getElementById('bracket-list').classList.toggle('hidden', _bracketShowingVisual)
  document.getElementById('bracket-toggle-icon').className = _bracketShowingVisual ? 'ph ph-list' : 'ph ph-graph'
  document.getElementById('bracket-toggle-label').textContent = _bracketShowingVisual ? 'Ver en lista' : 'Ver llaves'
}

function showRound(idx) {
  document.querySelectorAll('.bracket-round-mobile').forEach((el, i) => {
    el.style.display = i === idx ? 'block' : 'none'
  })
  document.querySelectorAll('.bracket-tab').forEach((btn, i) => {
    btn.classList.toggle('bg-wc-gold', i === idx)
    btn.classList.toggle('text-wc-dark', i === idx)
    btn.classList.toggle('bg-wc-card', i !== idx)
    btn.classList.toggle('text-wc-muted', i !== idx)
  })
}

// Drag-to-scroll for desktop
;(function () {
  const el = document.getElementById('bracket-visual')
  if (!el) return
  let isDown = false, startX = 0, scrollLeft = 0

  el.addEventListener('mousedown', (e) => {
    isDown = true
    el.style.cursor = 'grabbing'
    startX = e.pageX - el.offsetLeft
    scrollLeft = el.scrollLeft
    e.preventDefault()
  })
  el.addEventListener('mouseleave', () => { isDown = false; el.style.cursor = 'grab' })
  el.addEventListener('mouseup',    () => { isDown = false; el.style.cursor = 'grab' })
  el.addEventListener('mousemove',  (e) => {
    if (!isDown) return
    e.preventDefault()
    const x    = e.pageX - el.offsetLeft
    const walk = (x - startX) * 1.5
    el.scrollLeft = scrollLeft - walk
  })

  // Center the bracket on load
  el.scrollLeft = (el.scrollWidth - el.clientWidth) / 2
})()

// Format each knockout kickoff to the viewer's local date/time (system timezone),
// keeping the UI's Spanish locale.
;(function formatKnockoutDates() {
  var fmt = new Intl.DateTimeFormat('es-MX', {
    weekday: 'short', day: '2-digit', month: 'short',
    hour: '2-digit', minute: '2-digit', hour12: true,
  })
  document.querySelectorAll('.ko-date[data-utc]').forEach(function (el) {
    var iso = el.getAttribute('data-utc')
    if (!iso) return
    var d = new Date(iso)
    if (isNaN(d.getTime())) return
    el.textContent = fmt.format(d)
  })
})()
</script>
